# Dumb-E default configuration (ESP-IDF v6.0.x, target esp32).
# Do not put secrets here: this file is committed. WiFi credentials are set at runtime (`wifi` command).

# CPU / flash
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms FreeRTOS tick
CONFIG_FREERTOS_HZ=1000

# The step generator ISR must keep running while the flash cache is disabled (NVS/flash writes).
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
